      "query_id": "q_iocl_refinery_map_fy26",
      "sql": "SELECT r.refinery_id AS wc_id, r.refinery_name AS name, ROUND(f.throughput_mmt, 3) AS value, f.installed_capacity_mmtpa, f.grm_usd_bbl FROM hrfin_gold_v3.fact_refinery_annual f JOIN hrfin_gold_v3.dim_refinery r ON f.refinery_id = r.refinery_id WHERE f.fiscal_year = 'FY26' ORDER BY f.throughput_mmt DESC"
    }
